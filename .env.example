# Database — defaults to a local SQLite file for zero-setup use.
# For Postgres: postgresql+asyncpg://user:password@localhost:5432/threat_library
DATABASE_URL=sqlite+aiosqlite:///./threat_library.db

# Read-only REST API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# MCP server
MCP_SERVER_NAME=threat-library
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8001
