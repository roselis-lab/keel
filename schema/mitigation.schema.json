{
  "$defs": {
    "FailureDecision": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "description": "Why this value, in this control's terms",
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "value": {
          "enum": [
            "fail_closed",
            "fail_open",
            "degraded"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "note"
      ],
      "title": "FailureDecision",
      "type": "object"
    },
    "FaqItem": {
      "properties": {
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "answer"
      ],
      "title": "FaqItem",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "description": "How an org realizes a control. Empty in the reference catalog; orgs fill it in.",
      "properties": {
        "coverage": {
          "default": "local",
          "enum": [
            "shared",
            "local"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "covers": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when coverage='shared': the boundary this instance covers",
          "title": "Covers"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accountable role for THIS deployed instance (RACI single-Accountable)",
          "title": "Owner"
        },
        "reference": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "LocusDecision": {
      "additionalProperties": false,
      "properties": {
        "note": {
          "description": "Why this value, in this control's terms",
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "value": {
          "enum": [
            "product",
            "infrastructure",
            "split"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "note"
      ],
      "title": "LocusDecision",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "The evidence a control leaves behind.\n\nStructured rather than prose because the events are the thing: they are counted,\ncompared against what a system actually emits, and one day joined across controls\ninto a single trace. None of that is possible against a paragraph.",
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/TelemetryEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the record is held and for how long - a log the producing system can rewrite is not evidence",
          "title": "Evidence"
        }
      },
      "title": "Telemetry",
      "type": "object"
    },
    "TelemetryEvent": {
      "additionalProperties": false,
      "description": "One logged event and what it has to carry to be worth logging.",
      "properties": {
        "attributes": {
          "description": "Attributes without which the event proves nothing - attribution above all: who acted, on what, what was decided",
          "items": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "array"
        },
        "name": {
          "description": "The event's name, as it is emitted",
          "title": "Name",
          "type": "string"
        },
        "records": {
          "description": "What this event establishes, in one line",
          "title": "Records",
          "type": "string"
        }
      },
      "required": [
        "name",
        "records"
      ],
      "title": "TelemetryEvent",
      "type": "object"
    },
    "ValidationCheck": {
      "description": "One pass/fail acceptance criterion with its test scenario.",
      "properties": {
        "base": {
          "default": true,
          "title": "Base",
          "type": "boolean"
        },
        "criterion": {
          "title": "Criterion",
          "type": "string"
        },
        "expected_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Result"
        },
        "test_scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Scenario"
        }
      },
      "required": [
        "criterion"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anti_patterns": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Anti Patterns"
    },
    "control_mechanism": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Read per mitigation_class",
      "title": "Control Mechanism"
    },
    "failure_behavior": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What happens when the control fails, and what makes it so"
    },
    "faq": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/FaqItem"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Faq"
    },
    "formal_implementation_risk": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What a useless-but-mitigation-looking implementation looks like",
      "title": "Formal Implementation Risk"
    },
    "id": {
      "description": "Unique mitigation ID (e.g. CTRL-ACCESS-CONTROL). It is also the file name, so anything that could be read as a path is refused",
      "title": "Id",
      "type": "string"
    },
    "implementations": {
      "items": {
        "$ref": "#/$defs/Implementation"
      },
      "title": "Implementations",
      "type": "array"
    },
    "locus": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocusDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Which layer this control's mechanism belongs to, and why"
    },
    "maintainer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintainer"
    },
    "mitigation_class": {
      "description": "Required on create",
      "enum": [
        "gating_control",
        "detector",
        "process",
        "evidential_mitigation",
        "corrective"
      ],
      "title": "Mitigation Class",
      "type": "string"
    },
    "name": {
      "description": "Name of the mitigation",
      "title": "Name",
      "type": "string"
    },
    "out_of_scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What this control deliberately does not cover, and where that is handled instead. Its own field because a boundary written at the end of a long scope is the first thing dropped, and an absent field is visible",
      "title": "Out Of Scope"
    },
    "positioning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How this entry sits relative to the entries in the sources Keel tracks - only what the mapping itself does not already say. Where a source's entry is broader than this one, say what the rest of it is and where that lives. Never catalog state (which is computed) and never a to-do",
      "title": "Positioning"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1-3 sentences: which class of failure it prevents",
      "title": "Purpose"
    },
    "requires": {
      "description": "Mitigation ids this control presupposes. Use it only when this card's acceptance criteria cannot be checked without the other one being in place - not for controls that merely pair well",
      "items": {
        "type": "string"
      },
      "title": "Requires",
      "type": "array"
    },
    "review": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Change-triggers + safety-net review cadence",
      "title": "Review"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deterministic applicability rule + profiles",
      "title": "Scope"
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/Telemetry"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation"
    }
  },
  "required": [
    "name",
    "mitigation_class",
    "id"
  ],
  "title": "MitigationCreate",
  "type": "object"
}
